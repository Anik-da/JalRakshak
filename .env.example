# JalRakshak AI — Environment Variables Reference

# AWS Infrastructure Configuration (Serverless Backend)
AWS_REGION=ap-south-1
ENVIRONMENT=dev
PORT=4000

# Amazon DynamoDB Tables
REPORTS_TABLE_NAME=JalRakshak-Reports-dev
RISK_TABLE_NAME=JalRakshak-Risk-dev
AUDIT_TABLE_NAME=JalRakshak-Audit-dev
WEATHER_CACHE_TABLE_NAME=JalRakshak-WeatherCache-dev

# Amazon S3 Bucket
REPORT_IMAGES_BUCKET=jalrakshak-report-images-dev

# Amazon Cognito & Google Identity Provider Federation
USER_POOL_ID=ap-south-1_Hjjc9K0mC
USER_POOL_CLIENT_ID=1702hioeaa6an41037tqvcvmtq
COGNITO_DOMAIN=jalrakshak-auth.auth.ap-south-1.amazoncognito.com
# Google Cloud OAuth 2.0 Credentials (Configured in AWS Cognito User Pool console as Google IdP)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Amazon SES (Simple Email Service)
SES_FROM_EMAIL=alerts@jalrakshak.org
SES_CONFIGURATION_SET=
# Note: While SES is in Sandbox mode, destination recipient emails must be verified identities in AWS SES Console.

# Amazon SNS (Simple Notification Service - SMS)
SNS_DEFAULT_SENDER_ID=JALRAKSHAK
# Note: For India (+91) SMS delivery, TRAI DLT Principal Entity ID and Template ID registration is required under TCCCPR 2018.

# Frontend Environment Variables (Vite Client)
# Note: In browser bundles, only VITE_ prefixed variables are exposed and strictly contain non-sensitive IDs.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_Hjjc9K0mC
VITE_COGNITO_CLIENT_ID=1702hioeaa6an41037tqvcvmtq
VITE_COGNITO_DOMAIN=jalrakshak-auth.auth.ap-south-1.amazoncognito.com


