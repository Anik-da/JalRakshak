version = 0.1

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
stack_name = "jalrakshak-ai-stack"
s3_prefix = "jalrakshak-ai"
region = "ap-south-1"
parameter_overrides = [
  "Environment=\"dev\"",
  "AppDomainName=\"\""
]
image_repositories = []
